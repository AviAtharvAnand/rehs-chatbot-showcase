---
import Layout from '~/layouts/PageLayout.astro';
import Brands from '~/components/widgets/Brands.astro';

const metadata = {
  title: 'Partners',
};

const images = await Astro.glob("/src/assets/images/partners/*").then(files => {
  return files.map(file => ({src: file.default}));
});
---

<Layout metadata={metadata}>
  <Brands
  title="Partners"
  subtitle="Partners that make this project possible."
  images={images}
/>
</Layout>
