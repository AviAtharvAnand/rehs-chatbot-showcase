---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Annual Meetings',
};

const meetings = [
  {
    title: 'Seventh National Research Platform Workshop',
    shortTitle: '7NRP Workshop',
    date: 'May 5-7, 2026',
    location: 'UC San Diego, La Jolla, CA',
    description: 'Agenda, recordings, and slides from the seventh National Research Platform workshop.',
    href: '/7nrp-workshop/',
  },
  {
    title: 'Sixth National Research Platform Workshop',
    shortTitle: '6NRP Workshop',
    date: 'January 28-30, 2025',
    location: 'UC San Diego, La Jolla, CA',
    description: 'Agenda, recordings, and slides from the sixth National Research Platform workshop.',
    href: '/6nrp-workshop/',
  },
  {
    title: 'Fifth National Research Platform Workshop',
    shortTitle: '5NRP Workshop',
    date: 'March 19-22, 2024',
    location: 'UC San Diego, La Jolla, CA',
    description: 'Agenda, recordings, and slides from the fifth National Research Platform workshop.',
    href: '/5nrp-workshop/',
  },
];
---

<Layout metadata={metadata}>
  <section class="relative py-16 bg-slate-50 dark:bg-slate-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-10">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
          Annual Meetings
        </h1>
        <p class="text-lg text-slate-700 dark:text-slate-300">
          National Research Platform annual meeting materials, agendas, recordings, and slides.
        </p>
      </div>

      <div class="grid gap-6">
        {
          meetings.map((meeting) => (
            <article class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 shadow-sm">
              <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div>
                  <p class="text-sm font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300">
                    {meeting.shortTitle}
                  </p>
                  <h2 class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">{meeting.title}</h2>
                  <p class="mt-2 text-slate-700 dark:text-slate-300">{meeting.description}</p>
                  <dl class="mt-4 grid gap-2 text-sm text-slate-600 dark:text-slate-400 sm:grid-cols-2">
                    <div>
                      <dt class="font-semibold text-slate-800 dark:text-slate-200">Date</dt>
                      <dd>{meeting.date}</dd>
                    </div>
                    <div>
                      <dt class="font-semibold text-slate-800 dark:text-slate-200">Location</dt>
                      <dd>{meeting.location}</dd>
                    </div>
                  </dl>
                </div>

                <a
                  href={meeting.href}
                  class="inline-flex shrink-0 items-center justify-center rounded-md bg-blue-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900"
                >
                  View Materials
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
