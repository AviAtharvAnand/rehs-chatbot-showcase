---
import { text } from '@observablehq/plot';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
  alert = await Astro.slots.render('alert'),

  id,
  bg = await Astro.slots.render('bg'),
  bgImage = await Astro.slots.render('bgImage'),
  whiteText,
} = Astro.props;
// sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
// width={1024}
//         widths={[400, 768, 1024, 2040]}
---

<section class="relative not-prose md:-mt-[96px] overflow-hidden" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
      {bgImage ? (
        <Image
        class="brightness-50 object-cover object-center w-full h-full"
        loading="eager"
        {...bgImage}
      />
      ) : null}
    </slot>
    {whiteText && <div class="absolute inset-0 bg-slate-950/60"></div>}
  </div>
  <div class="pointer-events-none md:pt-[96px] pt-0"></div>
    {
      alert && (
        <div class="relative  mx-auto w-full">
          <div set:html={alert}></div>

        </div>
      )
    }
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    
    <div class="py-12 md:py-12">
      <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
        {
          tagline && (
            <p
              class:list={["text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:md:intersect:animate-fade", {'text-white': whiteText}]}
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class:list={["text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200 intersect-once intersect-quarter motion-safe:md:intersect:animate-fade", {'text-white': whiteText}]}
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl mx-auto">
          {
            subtitle && (
              <p
                class:list={["text-xl mb-6 dark:text-slate-300 intersect-once intersect-quarter motion-safe:md:intersect:animate-fade", {'text-white': whiteText}, {'text-muted': !whiteText}]}
                set:html={subtitle}
              />
            )
          }
          {
            actions && (
              <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class:list={["w-full sm:mb-0", {'text-white': whiteText}]} />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      <div
        class="intersect-once intercept-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      >
        {
          image && (
            <div class="relative m-auto max-w-5xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="mx-auto rounded-md w-full"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  width={1024}
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
