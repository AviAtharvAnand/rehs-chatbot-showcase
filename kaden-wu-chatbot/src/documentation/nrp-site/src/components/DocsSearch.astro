---
import DefaultSearch from '@astrojs/starlight/components/Search.astro';
---

<DefaultSearch {...Astro.props} />

<script is:inline>
  (function () {
    function applySearchInputLabel() {
      const input = document.querySelector('#starlight__search input.pagefind-ui__search-input');
      if (!input) return;
      if (!input.getAttribute('aria-label')) input.setAttribute('aria-label', 'Search documentation');
      if (!input.getAttribute('title')) input.setAttribute('title', 'Search documentation');
    }

    function initSearchA11yFix() {
      applySearchInputLabel();

      const mount = document.getElementById('starlight__search');
      if (!mount) return;

      if (!window.__nrpSearchA11yObserver) {
        const observer = new MutationObserver(() => applySearchInputLabel());
        observer.observe(mount, { childList: true, subtree: true });
        window.__nrpSearchA11yObserver = observer;
      }
    }

    document.addEventListener('DOMContentLoaded', initSearchA11yFix);
    document.addEventListener('astro:page-load', initSearchA11yFix);
  })();
</script>
