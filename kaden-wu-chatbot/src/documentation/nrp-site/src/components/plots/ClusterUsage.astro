                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${(ns.gpuHours || 0).toFixed(2)}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${(ns.memoryHours || 0).toFixed(2)}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${(ns.storageHours || 0).toFixed(2)}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${(ns.fpgaHours || 0).toFixed(2)}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${ns.PI || ''}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${ns.institution || ''}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${ns.description || ''}</td>
            `;
            tbody.appendChild(tr);
        });

        updateSortIndicators('ns-stats');
    };

    const updateNodeStatsTable = (nodes) => {
        currentFilteredNodes = Array.isArray(nodes) ? nodes.slice() : [];
        const tbody = document.getElementById('node-stats-table-body');
        if (!tbody) return;
        tbody.innerHTML = '';

        // Apply in-table filters (regex, case-insensitive)
        const nodeR = new RegExp((document.getElementById('node-stats-node-filter')?.value || '.*'), 'i');
        const typeR = new RegExp((document.getElementById('node-stats-gpuType-filter')?.value || '.*'), 'i');
        const cpuR2 = new RegExp((document.getElementById('node-stats-cpu-filter')?.value || '.*'), 'i');
        const gpuR2 = new RegExp((document.getElementById('node-stats-gpu-filter')?.value || '.*'), 'i');
        const memR2 = new RegExp((document.getElementById('node-stats-memory-filter')?.value || '.*'), 'i');
        const storR2 = new RegExp((document.getElementById('node-stats-storage-filter')?.value || '.*'), 'i');
        const fpgaR2 = new RegExp((document.getElementById('node-stats-fpga-filter')?.value || '.*'), 'i');

        let rows = currentFilteredNodes.slice().filter(n =>
            nodeR.test(n.node || '') &&
            typeR.test(n.gpuType || '') &&
            cpuR2.test(((n.cpuHours || 0).toFixed ? n.cpuHours.toFixed(2) : n.cpuHours).toString()) &&
            gpuR2.test(((n.gpuHours || 0).toFixed ? n.gpuHours.toFixed(2) : n.gpuHours).toString()) &&
            memR2.test(((n.memoryHours || 0).toFixed ? n.memoryHours.toFixed(2) : n.memoryHours).toString()) &&
            storR2.test(((n.storageHours || 0).toFixed ? n.storageHours.toFixed(2) : n.storageHours).toString()) &&
            fpgaR2.test(((n.fpgaHours || 0).toFixed ? n.fpgaHours.toFixed(2) : n.fpgaHours).toString())
        );
        // Persist filtered rows for CSV/export
        currentFilteredNodes = rows.slice();
        const nodeStatsState = sortStates['node-stats'];
        if (nodeStatsState && nodeStatsState.key) {
            const dir = nodeStatsState.dir === 'asc' ? 1 : -1;
            const acc = nodeStatsAccessors[nodeStatsState.key] || ((r) => r[nodeStatsState.key]);
            rows.sort((a,b) => compareValues(acc(a), acc(b)) * dir);
        } else {
            rows.sort((a, b) => (b.cpuHours + b.gpuHours + b.memoryHours + b.storageHours + b.fpgaHours) - (a.cpuHours + a.gpuHours + a.memoryHours + a.storageHours + a.fpgaHours));
        }

        rows.forEach(node => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900\">${node.node}</td>
                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">${node.gpuType || ''}</td>
                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">${(node.cpuHours || 0).toFixed(2)}</td>
                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">${(node.gpuHours || 0).toFixed(2)}</td>
                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">${(node.memoryHours || 0).toFixed(2)}</td>
                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">${(node.storageHours || 0).toFixed(2)}</td>
                <td class=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">${(node.fpgaHours || 0).toFixed(2)}</td>
            `;
            tbody.appendChild(tr);
        });

        updateSortIndicators('node-stats');
    };

    let currentGpuStats = [];
    const updateGpuStatsTable = (nodes) => {
        const tbody = document.getElementById('gpu-stats-table-body');
        if (!tbody) return;
        const byType = new Map();
        (nodes || []).forEach(n => {
            const type = (n.gpuType || '').trim();
            const hours = typeof n.gpuHours === 'number' ? n.gpuHours : 0;
            if (!type || type.toLowerCase() === 'unknown' || hours <= 0) return;
            byType.set(type, (byType.get(type) || 0) + hours);
        });
        currentGpuStats = Array.from(byType, ([gpuType, hours]) => ({ gpuType, hours }));
        // Apply in-table filters (regex, case-insensitive)
        const typeR3 = new RegExp((document.getElementById('gpu-stats-type-filter')?.value || '.*'), 'i');
        const hoursR3 = new RegExp((document.getElementById('gpu-stats-hours-filter')?.value || '.*'), 'i');
        let gpuRows = currentGpuStats.slice().filter(r =>
            typeR3.test(r.gpuType || '') &&
            hoursR3.test(((r.hours || 0).toFixed ? r.hours.toFixed(2) : r.hours).toString())
        );
        // Persist filtered GPU rows for CSV/export
        currentGpuStats = gpuRows.slice();
        const gpuState = sortStates['gpu-stats'];
        if (gpuState && gpuState.key) {
            const dir = gpuState.dir === 'asc' ? 1 : -1;
            const acc = gpuAccessors[gpuState.key] || ((r) => r[gpuState.key]);
            gpuRows.sort((a,b) => compareValues(acc(a), acc(b)) * dir);
        } else {
            gpuRows.sort((a, b) => b.hours - a.hours);
        }
        tbody.innerHTML = '';
        gpuRows.forEach(row => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${row.gpuType}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${row.hours.toFixed(2)}</td>
            `;
            tbody.appendChild(tr);
        });

        updateSortIndicators('gpu-stats');
    };

    const updateNodeTable = (nodes) => {
        const tbody = document.getElementById('nodes-table-body');
        tbody.innerHTML = '';

        let nodeRows = Array.isArray(nodes) ? nodes.slice() : [];
        const nodesSelState = sortStates['nodes-selected'];
        if (nodesSelState && nodesSelState.key) {
            const dir = nodesSelState.dir === 'asc' ? 1 : -1;
            const acc = nodeSelectedAccessors[nodesSelState.key] || ((r) => r[nodesSelState.key]);
            nodeRows.sort((a,b) => compareValues(acc(a), acc(b)) * dir);
        } else {
            nodeRows.sort((a, b) => (b.cpuHours + b.gpuHours + b.memoryHours) - (a.cpuHours + a.gpuHours + a.memoryHours));
        }
        currentSelectedNodes = nodeRows.slice();
        nodeRows.forEach(node => {
            const row = document.createElement('tr');
            row.innerHTML = `
                <td class="px-6 py-4 whitespace-nowrap">
                    <input type="checkbox" class="node-checkbox" value="${node.node}" checked>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${node.node}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${node.owner || ''}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${node.region}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${node.zone}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${node.gpuType}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${node.fpgaType}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${node.taints}</td>
            `;
            tbody.appendChild(row);
        });

        updateSortIndicators('nodes-selected');

        // Add event listeners for checkboxes
        document.querySelectorAll('.node-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', () => {
                syncNodeHeaderCheckbox();
                updateCharts();
            });
        });

        // Sync header checkbox state
        syncNodeHeaderCheckbox();
    };

    // Header checkbox sync functions
    const syncNamespaceHeaderCheckbox = () => {
        const header = document.getElementById('namespace-select-all');
        const boxes = document.querySelectorAll('.namespace-checkbox');
        if (!header) return;
        if (boxes.length === 0) { header.checked = false; header.disabled = true; return; }
        header.disabled = false;
        header.checked = Array.from(boxes).every(cb => cb.checked);
    };

    const syncNodeHeaderCheckbox = () => {
        const header = document.getElementById('node-select-all');
        const boxes = document.querySelectorAll('.node-checkbox');
        if (!header) return;
        if (boxes.length === 0) { header.checked = false; header.disabled = true; return; }
        header.disabled = false;
        header.checked = Array.from(boxes).every(cb => cb.checked);
    };

    const getSelectedNamespaces = () => {
        const selected = [];
        document.querySelectorAll('.namespace-checkbox:checked').forEach(checkbox => {
            const namespace = allNamespaces.find(ns => ns.namespace === checkbox.value);
            if (namespace) selected.push(namespace);
        });
        return selected;
    };

    const getSelectedNodes = () => {
        const selected = [];
        document.querySelectorAll('.node-checkbox:checked').forEach(checkbox => {
            const node = allNodes.find(n => n.node === checkbox.value);
            if (node) selected.push(node);
        });
        return selected;
    };

    const updateSortIndicators = (tableKey) => {
        const state = sortStates[tableKey];
        const ths = document.querySelectorAll(`th[data-table="${tableKey}"][data-key]`);
        const upIcon = '▲';
        const downIcon = '▼';
        ths.forEach(th => {
            const ind = th.querySelector('.sort-indicator');
            th.removeAttribute('aria-sort');
            if (ind) ind.textContent = '';
            if (state && state.key && th.getAttribute('data-key') === state.key) {
                if (ind) ind.textContent = state.dir === 'asc' ? upIcon : downIcon;
                th.setAttribute('aria-sort', state.dir === 'asc' ? 'ascending' : 'descending');
            }
        });
    };

    const refreshTableForSort = (tableKey) => {
        switch (tableKey) {
            case 'ns-selected':
                updateNamespaceTable(currentSelectedNamespaces);
                break;
            case 'nodes-selected':
                updateNodeTable(currentSelectedNodes);
                break;
            case 'ns-stats':
                updateNamespaceStatsTable(currentFilteredNamespaces);
                break;
            case 'node-stats':
                updateNodeStatsTable(currentFilteredNodes);
                break;
            case 'gpu-stats':
                updateGpuStatsTable(currentFilteredNodes);
                break;
        }
        updateSortIndicators(tableKey);
    };

    const initSorting = () => {
        document.querySelectorAll('th[data-table][data-key]').forEach(th => {
            th.addEventListener('click', () => {
                const tableKey = th.getAttribute('data-table');
                const key = th.getAttribute('data-key');
                const type = th.getAttribute('data-type') || 'string';
                const state = sortStates[tableKey] || { key: null, dir: 'asc' };
                if (state.key === key) {
                    state.dir = state.dir === 'asc' ? 'desc' : 'asc';
                } else {
                    state.key = key;
                    state.dir = type === 'number' ? 'desc' : 'asc';
                }
                sortStates[tableKey] = state;
                refreshTableForSort(tableKey);
            });
        });

        // Apply default sorts from table datasets if provided
        document.querySelectorAll('table[data-table-key]').forEach(tbl => {
            const tableKey = tbl.getAttribute('data-table-key');
            const defKey = tbl.getAttribute('data-default-sort-key');
            const defDir = tbl.getAttribute('data-default-sort-dir');
            if (tableKey && defKey && (!sortStates[tableKey] || !sortStates[tableKey].key)) {
                sortStates[tableKey] = { key: defKey, dir: (defDir === 'asc' ? 'asc' : 'desc') };
                refreshTableForSort(tableKey);
            }
        });
    };

    const createBarChart = (data, valueKey, title, color = "#1f77b4", isNode = false) => {
        try {
            if (!data || data.length === 0) return null;

            const filteredData = data
                .filter(d => d && typeof d[valueKey] === 'number' && d[valueKey] > 0)
                .sort((a, b) => b[valueKey] - a[valueKey])
                .slice(0, 25)
                .map(d => ({ name: isNode ? d.node : d.namespace, value: d[valueKey] }));

            if (filteredData.length === 0) return null;

            return Plot.plot({
                height: 400,
                width: 1000,
                marginLeft: 120,
                marginBottom: 100,
                marks: [
                    Plot.barY(filteredData, { 
                        x: "name", 
                        y: "value", 
                        fill: color,
                        tip: true,
                        title: d => `${d.name}: ${(+d.value).toFixed(2)} h`
                    }),
                    Plot.ruleY([0])
                ],
                x: {
                    label: isNode ? "Node" : "Namespace",
                    tickRotate: 45,
                    domain: filteredData.map(d => d.name)
                },
                y: {
                    label: "Hours"
                }
            });
        } catch (err) {
            console.error('Error creating bar chart:', err);
            return null;
        }
    };

    const createPieChart = (nodesData) => {
        // Aggregate GPU hours by GPU type from node data
        const byType = new Map();
        (nodesData || []).forEach(n => {
            const type = (n.gpuType || '').trim();
            const hours = typeof n.gpuHours === 'number' ? n.gpuHours : 0;
            if (!type || type.toLowerCase() === 'unknown' || hours <= 0) return;
            byType.set(type, (byType.get(type) || 0) + hours);
        });

        let gpuData = Array.from(byType, ([gpuType, hours]) => ({ gpuType, hours }))
            .sort((a, b) => b.hours - a.hours)
            .slice(0, 10);

        if (gpuData.length === 0) return null;

        try {
            // Labeled pie chart adapted from Observable’s PieChart
            function PieChart(data, {
                name = d => d.gpuType,
                value = d => d.hours,
                title,
                width = 600,
                height = 400,
                innerRadius = 0,
                outerRadius = Math.min(width, height) / 2,
                labelRadius = (innerRadius * 0.2 + outerRadius * 0.8),
                format = ",",
                names,
                colors,
                stroke = innerRadius > 0 ? "none" : "white",
                strokeWidth = 1,
                strokeLinejoin = "round",
                padAngle = stroke === "none" ? 1 / outerRadius : 0,
            } = {}) {
              // sort largest first for readability
              data = data.slice().sort((a, b) => (value(b) || 0) - (value(a) || 0));

              const N = d3.map(data, name);
              const V = d3.map(data, value);
              const I = d3.range(N.length).filter(i => !isNaN(V[i]));

              if (names === undefined) names = N;
              names = new d3.InternSet(names);

              if (colors === undefined) colors = d3.schemeSpectral[names.size];
              if (colors === undefined) colors = d3.quantize(t => d3.interpolateSpectral(t * 0.8 + 0.1), names.size);

              const color = d3.scaleOrdinal(names, colors);

              if (title === undefined) {
                const formatValue = d3.format(format);
                title = i => `${N[i]}\n${formatValue(V[i])} h`;
              } else {
                const O = d3.map(data, d => d);
                const T = title;
                title = i => T(O[i], i, data);
              }

              const arcs = d3.pie().padAngle(padAngle).sort(null).value(i => V[i])(I);
              const arc = d3.arc().innerRadius(innerRadius).outerRadius(outerRadius);
              const arcLabel = d3.arc().innerRadius(labelRadius).outerRadius(labelRadius);
              const sumV = d3.sum(I, i => V[i]);

              // wrapper for custom tooltip positioning
              const container = document.createElement('div');
              container.style.position = 'relative';

              const svg = d3.create("svg")
                  .attr("width", width)
                  .attr("height", height)
                  .attr("viewBox", [-width / 2, -height / 2, width, height])
                  .attr("style", "max-width: 100%; height: auto; height: intrinsic;");

              const paths = svg.append("g")
                  .attr("stroke", stroke)
                  .attr("stroke-width", strokeWidth)
                  .attr("stroke-linejoin", strokeLinejoin)
                .selectAll("path")
                .data(arcs)
                .join("path")
                  .attr("fill", d => color(N[d.data]))
                  .attr("d", arc);

              // custom tooltip
              const tip = document.createElement('div');
              tip.style.position = 'absolute';
              tip.style.pointerEvents = 'none';
              tip.style.background = 'rgba(255,255,255,0.98)';
              tip.style.border = '1px solid rgba(0,0,0,0.1)';
              tip.style.borderRadius = '0.375rem';
              tip.style.boxShadow = '0 2px 8px rgba(0,0,0,0.08)';
              tip.style.padding = '6px 8px';
              tip.style.fontSize = '12px';
              tip.style.color = '#111827';
              tip.style.display = 'none';

              paths
                .on('mousemove', (event, d) => {
                  const rect = container.getBoundingClientRect();
                  tip.style.display = 'block';
                  tip.innerHTML = String(title(d.data)).replace(/\n/g, '<br>');
                  tip.style.left = (event.clientX - rect.left + 12) + 'px';
                  tip.style.top = (event.clientY - rect.top + 12) + 'px';
                })
                .on('mouseleave', () => {
                  tip.style.display = 'none';
                });

              svg.append("g")
                  .attr("font-family", "sans-serif")
                  .attr("font-size", 12)
                  .attr("text-anchor", "middle")
                .selectAll("text")
                .data(arcs.filter(d => (d.endAngle - d.startAngle) >= 0.18 || (V[d.data] / (sumV || 1)) >= 0.05))
                .join("text")
                  .attr("transform", d => `translate(${arcLabel.centroid(d)})`)
                .selectAll("tspan")
                .data((d, i) => {
                  const lines = `${title(d.data)}`.split(/\n/);
                  return (d.endAngle - d.startAngle) > 0.25 ? lines : lines.slice(0, 1);
                })
                .join("tspan")
                  .attr("x", 0)
                  .attr("y", (_, i) => `${i * 1.1}em`)
                  .attr("font-weight", (_, i) => i ? null : "bold")
                  .text(d => d);

              container.appendChild(svg.node());
              container.appendChild(tip);
              return container;
            }

            return PieChart(gpuData, {
                name: d => d.gpuType,
                value: d => d.hours,
                title: d => `${d.gpuType}\n${d.hours.toFixed(2)} h`,
                width: 600,
                height: 400
            });
        } catch (err) {
            console.error('Error creating pie chart:', err);
            return null;
        }
    };

    // Active chart tabs (metric + color)
    let nsChartMetric = { key: 'cpuHours', color: '#1f77b4' };
    let nodeChartMetric = { key: 'cpuHours', color: '#1f77b4' };

    const updateCharts = () => {
        const selectedNamespaces = getSelectedNamespaces();
        const selectedNodes = getSelectedNodes();

        const nsSet = new Set(selectedNamespaces.map(ns => ns.namespace));
        const nodeSet = new Set(selectedNodes.map(n => n.node));

        // Re-aggregate by intersection of selected namespaces AND nodes
        const nsAggMap = new Map();
        const nodeAggMap = new Map();

        baseRows.forEach(r => {
            if (!nsSet.has(r.namespace) || !nodeSet.has(r.node)) return;
            // namespace agg
            if (!nsAggMap.has(r.namespace)) {
                const meta = namespaceMeta.get(r.namespace) || {};
                nsAggMap.set(r.namespace, {
                    namespace: r.namespace,
                    PI: meta.PI || 'unknown',
                    institution: meta.institution || 'unknown',
                    description: meta.description || '',
                    cpuHours: 0,
                    memoryHours: 0,
                    gpuHours: 0,
                    fpgaHours: 0,
                    storageHours: 0
                });
            }
            const ns = nsAggMap.get(r.namespace);
            if (r.resource === 'cpu') ns.cpuHours += r.value;
            else if (r.resource === 'memory') ns.memoryHours += r.value;
            else if (r.resource === 'gpu') ns.gpuHours += r.value;
            else if (r.resource === 'fpga') ns.fpgaHours += r.value;
            else if (r.resource === 'storage') ns.storageHours += r.value;

            // node agg
            if (!nodeAggMap.has(r.node)) {
                const meta = nodeMeta.get(r.node) || {};
                nodeAggMap.set(r.node, {
                    node: r.node,
                    region: meta.region || 'unknown',
                    zone: meta.zone || 'unknown',
                    gpuType: meta.gpuType || 'unknown',
                    fpgaType: meta.fpgaType || 'unknown',
                    taints: meta.taints || '',
                    cpuHours: 0,
                    memoryHours: 0,
                    gpuHours: 0,
                    fpgaHours: 0,
                    storageHours: 0
                });
            }
            const nd = nodeAggMap.get(r.node);
            if (r.resource === 'cpu') nd.cpuHours += r.value;
            else if (r.resource === 'memory') nd.memoryHours += r.value;
            else if (r.resource === 'gpu') nd.gpuHours += r.value;
            else if (r.resource === 'fpga') nd.fpgaHours += r.value;
            else if (r.resource === 'storage') nd.storageHours += r.value;
        });

        const nsAgg = Array.from(nsAggMap.values());
        const nodeAgg = Array.from(nodeAggMap.values());

        // Keep stats tables in sync with current intersection
        updateNamespaceStatsTable(nsAgg);
        updateNodeStatsTable(nodeAgg);

        // Clear and render namespace chart for selected tab
        const nsContainer = document.getElementById('namespace-chart');
        if (nsContainer) {
            nsContainer.innerHTML = '';
            const chart = createBarChart(nsAgg, nsChartMetric.key, '', nsChartMetric.color, false);
            if (chart) nsContainer.appendChild(chart);
            else nsContainer.innerHTML = '<p class="text-gray-500 text-center py-8">No data available</p>';
        }

        // Clear and render node chart for selected tab
        const nodeContainer = document.getElementById('node-chart');
        if (nodeContainer) {
            nodeContainer.innerHTML = '';
            const chart = createBarChart(nodeAgg, nodeChartMetric.key, '', nodeChartMetric.color, true);
            if (chart) nodeContainer.appendChild(chart);
            else nodeContainer.innerHTML = '<p class="text-gray-500 text-center py-8">No data available</p>';
        }

        // GPU pie + GPU table
        const pie = createPieChart(nodeAgg);
        const pieEl = document.getElementById('gpu-pie-chart');
        if (pieEl) {
            pieEl.innerHTML = '';
            if (pie) pieEl.appendChild(pie);
            else pieEl.innerHTML = '<p class="text-gray-500 text-center py-8">No data available</p>';
        }
        updateGpuStatsTable(nodeAgg);
    };

    

    // Status helpers
    const setStatus = (message, type = 'info', spinning = false) => {
        const wrapper = document.getElementById('data-status');
        const textEl = document.getElementById('data-status-text');
        const spinner = document.getElementById('data-status-spinner');
        if (!wrapper || !textEl || !spinner) return;
        textEl.textContent = message;
        spinner.classList.toggle('hidden', !spinning);
        wrapper.classList.remove('hidden');
        const box = wrapper.firstElementChild;
        box.className = 'flex items-center gap-3 p-3 rounded-md border text-sm';
        if (type === 'error') {
            box.classList.add('bg-red-50','text-red-800','border-red-200');
        } else if (type === 'success') {
            box.classList.add('bg-green-50','text-green-800','border-green-200');
        } else if (type === 'loading') {
            box.classList.add('bg-blue-50','text-blue-800','border-blue-200');
        } else {
            box.classList.add('bg-gray-50','text-gray-800','border-gray-200');
        }
    };

    const clearStatus = () => {
        const wrapper = document.getElementById('data-status');
        if (wrapper) wrapper.classList.add('hidden');
    };

    const setControlsDisabled = (disabled) => {
        ['search-data']
            .forEach(id => {
                const el = document.getElementById(id);
                if (el) el.disabled = disabled;
            });
    };

    const refreshData = async () => {
        try {
            setControlsDisabled(true);
            const t0 = performance.now();
            setStatus('Loading data… this could take a minute', 'loading', true);
            const data = await fetchResourceData();
            console.log('Fetched resource data:', data);
            if (data && data.rawResourceData) {
                try {
                    aggregateData(data);
                    console.log('Aggregated data:', { namespaces: allNamespaces.length, nodes: allNodes.length });
                } catch (e) {
                    console.error('aggregateData error:', e);
                    throw e;
                }
                try {
                    applyRegexFilters(); // also triggers updateCharts
                    console.log('Applied regex filters and updated charts');
                    const now = new Date();
                    const seconds = ((performance.now() - t0) / 1000).toFixed(2);
                    const modeLabel = currentMode === 'used' ? 'Utilized' : 'Allocated';
                    setStatus(`Loaded ${modeLabel} data: ${allNamespaces.length} namespaces, ${allNodes.length} nodes in ${seconds}s · ${now.toLocaleString()}`, 'success', false);
                } catch (e) {
                    console.error('applyRegexFilters/updateCharts error:', e);
                }
            } else {
                console.warn('No resource data received');
                setStatus('No resource data received', 'error', false);
            }
        } catch (error) {
            console.error('Error refreshing data:', error);
            setStatus('Error loading data', 'error', false);
            // Clear plots on error
            const plotIds = [
                'namespace-cpu-plot', 'namespace-gpu-plot', 'namespace-fpga-plot',
                'namespace-memory-plot', 'namespace-storage-plot',
                'node-cpu-plot', 'node-gpu-plot', 'node-fpga-plot',
                'node-memory-plot', 'node-storage-plot', 'gpu-pie-chart'
            ];
            plotIds.forEach(id => {
                const element = document.getElementById(id);
                if (element) element.innerHTML = '<p class="text-red-500 text-center py-8">Error loading data</p>';
            });
        }
        finally {
            setControlsDisabled(false);
        }
    };

    // Event listeners
    const onSearch = () => {
        clearStatus();
        const valid = validateDateRange();
        if (valid.ok) {
            refreshData();
        }
    };
    document.getElementById('search-data').addEventListener('click', onSearch);
    
    // Filter input listeners
    ['namespace-name-filter', 'namespace-pi-filter', 'namespace-institution-filter', 'namespace-description-filter',
     'node-name-filter', 'node-region-filter', 'node-zone-filter', 'node-gpu-filter', 
     'node-fpga-filter', 'node-taints-filter',
     // stats table filters
     'ns-stats-namespace-filter','ns-stats-cpu-filter','ns-stats-gpu-filter','ns-stats-memory-filter','ns-stats-storage-filter','ns-stats-fpga-filter','ns-stats-pi-filter','ns-stats-institution-filter','ns-stats-description-filter',
     'node-stats-node-filter','node-stats-gpuType-filter','node-stats-cpu-filter','node-stats-gpu-filter','node-stats-memory-filter','node-stats-storage-filter','node-stats-fpga-filter',
     'gpu-stats-type-filter','gpu-stats-hours-filter'
    ].forEach(id => {
        document.getElementById(id).addEventListener('input', applyRegexFilters);
    });

    // Header checkbox listeners
    const nsHeader = document.getElementById('namespace-select-all');
    if (nsHeader) {
        nsHeader.addEventListener('change', (e) => {
            document.querySelectorAll('.namespace-checkbox').forEach(cb => cb.checked = e.target.checked);
            updateCharts();
        });
    }
    const nodeHeader = document.getElementById('node-select-all');
    if (nodeHeader) {
        nodeHeader.addEventListener('change', (e) => {
            document.querySelectorAll('.node-checkbox').forEach(cb => cb.checked = e.target.checked);
            updateCharts();
        });
    }

    // Download CSV for Namespace Stats
    const downloadBtn = document.getElementById('download-namespace-stats');
    if (downloadBtn) {
        downloadBtn.addEventListener('click', () => {
            try {
                const rows = currentFilteredNamespaces || [];
                const headers = [
                    'Namespace','CPU Hours','GPU Hours','Memory Hours','Ephemeral Storage Hours','FPGA Hours','PI','Institution','Description'
                ];
                const escapeCSV = (v) => {
                    const s = (v ?? '').toString();
                    return /[",\n]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
                };
                const lines = [headers.join(',')];
                rows.forEach(ns => {
                    lines.push([
                        ns.namespace,
                        (ns.cpuHours || 0).toFixed(2),
                        (ns.gpuHours || 0).toFixed(2),
                        (ns.memoryHours || 0).toFixed(2),
                        (ns.storageHours || 0).toFixed(2),
                        (ns.fpgaHours || 0).toFixed(2),
                        ns.PI || '',
                        ns.institution || '',
                        ns.description || ''
                    ].map(escapeCSV).join(','));
                });
                const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                const modeLabel = currentMode === 'used' ? 'utilized' : 'allocated';
                a.download = `usage-by-namespace-${modeLabel}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            } catch (err) {
                console.error('CSV download failed:', err);
            }
        });
    }

    // Download CSV for GPU Stats
    const downloadGpuBtn = document.getElementById('download-gpu-stats');
    if (downloadGpuBtn) {
        downloadGpuBtn.addEventListener('click', () => {
            try {
                const rows = currentGpuStats || [];
                const headers = ['GPU Type','Hours'];
                const escapeCSV = (v) => {
                    const s = (v ?? '').toString();
                    return /[",\n]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
                };
                const lines = [headers.join(',')];
                rows.forEach(r => {
                    lines.push([r.gpuType, r.hours.toFixed(2)].map(escapeCSV).join(','));
                });
                const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                const modeLabel = currentMode === 'used' ? 'utilized' : 'allocated';
                a.download = `usage-by-gpu-${modeLabel}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            } catch (err) {
                console.error('CSV download failed:', err);
            }
        });
    }

    // Download CSV for Node Stats
    const downloadNodeBtn = document.getElementById('download-node-stats');
    if (downloadNodeBtn) {
        downloadNodeBtn.addEventListener('click', () => {
            try {
                const rows = currentFilteredNodes || [];
                const headers = [
                    'Node','GPU Type','CPU Hours','GPU Hours','Memory Hours','Ephemeral Storage Hours','FPGA Hours'
                ];
                const escapeCSV = (v) => {
                    const s = (v ?? '').toString();
                    return /[",\n]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
                };
                const lines = [headers.join(',')];
                rows.forEach(n => {
                    lines.push([
                        n.node,
                        n.gpuType || '',
                        (n.cpuHours || 0).toFixed(2),
                        (n.gpuHours || 0).toFixed(2),
                        (n.memoryHours || 0).toFixed(2),
                        (n.storageHours || 0).toFixed(2),
                        (n.fpgaHours || 0).toFixed(2)
                    ].map(escapeCSV).join(','));
                });
                const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                const modeLabel = currentMode === 'used' ? 'utilized' : 'allocated';
                a.download = `usage-by-node-${modeLabel}.csv`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            } catch (err) {
                console.error('CSV download failed:', err);
            }
        });
    }

    // Initialize
    initializeDates();
    initSorting();
    setStatus('Choose a date range and click Search.', 'info', false);
    // Initialize mode UI
    const modeSwitch = document.getElementById('mode-switch');
    const allocLabel = document.getElementById('mode-label-allocated');
    const usedLabel = document.getElementById('mode-label-used');
    const updateModeUI = () => {
        const used = !!modeSwitch.checked;
        currentMode = used ? 'used' : 'allocated';
        if (used) {
            usedLabel.classList.remove('text-gray-500');
            usedLabel.classList.add('text-gray-900','font-medium');
            allocLabel.classList.remove('text-gray-900','font-medium');
            allocLabel.classList.add('text-gray-500');
        } else {
            allocLabel.classList.remove('text-gray-500');
            allocLabel.classList.add('text-gray-900','font-medium');
            usedLabel.classList.remove('text-gray-900','font-medium');
            usedLabel.classList.add('text-gray-500');
        }
    };
    if (modeSwitch) {
        modeSwitch.checked = currentMode === 'used';
        updateModeUI();
        modeSwitch.addEventListener('change', updateModeUI);
    }

    // Initialize chart tabs
    const setActiveTab = (containerId, activeBtn) => {
        const tabs = document.querySelectorAll(`#${containerId} button[data-metric]`);
        tabs.forEach(btn => {
            btn.classList.remove('text-gray-900','border-blue-600');
            btn.classList.add('text-gray-600','border-transparent');
        });
        activeBtn.classList.remove('text-gray-600','border-transparent');
        activeBtn.classList.add('text-gray-900','border-blue-600');
    };

    const nsTabs = document.getElementById('namespace-chart-tabs');
    if (nsTabs) {
        const first = nsTabs.querySelector('button[data-metric]');
        if (first) setActiveTab('namespace-chart-tabs', first);
        nsTabs.querySelectorAll('button[data-metric]').forEach(btn => {
            btn.addEventListener('click', () => {
                nsChartMetric = { key: btn.getAttribute('data-metric'), color: btn.getAttribute('data-color') };
                setActiveTab('namespace-chart-tabs', btn);
                updateCharts();
            });
        });
    }

    const nodeTabs = document.getElementById('node-chart-tabs');
    if (nodeTabs) {
        const first = nodeTabs.querySelector('button[data-metric]');
        if (first) setActiveTab('node-chart-tabs', first);
        nodeTabs.querySelectorAll('button[data-metric]').forEach(btn => {
            btn.addEventListener('click', () => {
                nodeChartMetric = { key: btn.getAttribute('data-metric'), color: btn.getAttribute('data-color') };
                setActiveTab('node-chart-tabs', btn);
                updateCharts();
            });
        });
    }
</script>
