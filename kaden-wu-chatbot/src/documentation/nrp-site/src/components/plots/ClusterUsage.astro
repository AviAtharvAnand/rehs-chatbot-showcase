---
import CheckboxTable from '~/components/common/CheckboxTable.astro';
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto max-w-7xl px-4 sm:px-6">
    
    <!-- Data Status -->
    <div id="data-status" class="mb-6 hidden">
        <div class="flex items-center gap-3 p-3 rounded-md border text-sm" aria-live="polite">
            <svg id="data-status-spinner" class="h-5 w-5 text-blue-600 animate-spin hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            <span id="data-status-text" class="font-medium"></span>
        </div>
    </div>

    <!-- Search Options + TOC -->
    <div class="mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Search Options Section -->
        <div id="search-options" class="bg-gray-50 p-6 rounded-lg md:col-span-2">
            <h3 class="text-lg font-semibold mb-4">Search Options</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="start-date" class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                    <input type="date" id="start-date" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label for="end-date" class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
                    <input type="date" id="end-date" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
            <div class="mt-4">
                <div class="flex items-center gap-3">
                    <span id="mode-label-allocated" class="text-sm font-medium text-gray-900">Allocated</span>
                <label class="inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="mode-switch" class="sr-only peer" aria-label="Toggle between Allocated and Utilized">
                        <div class="relative w-12 h-6 bg-gray-200 rounded-full transition-colors peer-focus:ring-2 peer-focus:ring-blue-500 dark:bg-gray-700 peer-checked:bg-blue-600 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5 after:bg-white after:rounded-full after:shadow after:transition-transform peer-checked:after:translate-x-6"></div>
                    </label>
                <span id="mode-label-used" class="text-sm text-gray-500">Utilized</span>
                </div>
            </div>
            <div class="mt-4">
                <button id="search-data" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md font-medium">Search</button>
            </div>
        </div>

        <!-- Table of Contents -->
        <aside class="md:col-span-1">
            <div class="bg-white border border-gray-200 rounded-lg p-4 md:sticky md:top-4">
                <h3 class="text-lg font-semibold mb-3">Contents</h3>
                <nav aria-label="Table of contents">
                    <ul class="space-y-2 text-sm">
                        <li><a class="text-blue-700 hover:underline" href="#search-options">Search Options</a></li>
                        <li><a class="text-blue-700 hover:underline" href="#namespace-filters">Namespace Filters</a></li>
                        <li><a class="text-blue-700 hover:underline" href="#node-filters">Node Filters</a></li>
                        <li><a class="text-blue-700 hover:underline" href="#namespace-stats">Usage by Namespace</a></li>
                        <li><a class="text-blue-700 hover:underline" href="#node-stats">Usage by Node</a></li>
                        <li><a class="text-blue-700 hover:underline" href="#gpu-stats">Usage by GPU</a></li>
                    </ul>
                </nav>
            </div>
        </aside>
    </div>

    

    <!-- Namespace Filters moved under table header -->

    <!-- Selected Namespaces Table -->
    <CheckboxTable
      containerId="namespace-filters"
      title="Selected Namespaces"
      tableKey="ns-selected"
      selectAllId="namespace-select-all"
      tbodyId="namespaces-table-body"
      checkboxClass="namespace-checkbox"
      columns={[
        { checkbox: true },
        { key: 'namespace', label: 'Namespace', type: 'string', filterId: 'namespace-name-filter' },
        { key: 'PI', label: 'PI', type: 'string', filterId: 'namespace-pi-filter' },
        { key: 'institution', label: 'Institution', type: 'string', filterId: 'namespace-institution-filter' },
        { key: 'description', label: 'Description', type: 'string', filterId: 'namespace-description-filter' },
      ]}
    />

    <!-- Node Filters moved under table header -->

    <!-- Selected Nodes Table -->
    <CheckboxTable
      containerId="node-filters"
      title="Selected Nodes"
      tableKey="nodes-selected"
      selectAllId="node-select-all"
      tbodyId="nodes-table-body"
      checkboxClass="node-checkbox"
      columns={[
        { checkbox: true },
        { key: 'node', label: 'Node', type: 'string', filterId: 'node-name-filter' },
        { key: 'owner', label: 'Owner', type: 'string', filterId: 'node-owner-filter' },
        { key: 'region', label: 'Region', type: 'string', filterId: 'node-region-filter' },
        { key: 'zone', label: 'Zone', type: 'string', filterId: 'node-zone-filter' },
        { key: 'gpuType', label: 'GPU Type', type: 'string', filterId: 'node-gpu-filter' },
        { key: 'fpgaType', label: 'FPGA Type', type: 'string', filterId: 'node-fpga-filter' },
        { key: 'taints', label: 'Node Taints', type: 'string', filterId: 'node-taints-filter' },
      ]}
    />

    <!-- Charts Section -->
    <div class="space-y-12">
        <!-- Namespace Charts -->
        <div id="namespace-stats">
            <h2 class="text-2xl font-bold mb-6">Usage by Namespace</h2>

            <div class="mb-4 border-b border-gray-200">
                <div id="namespace-chart-tabs" class="flex gap-2">
                    <button data-metric="cpuHours" data-color="#1f77b4" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">CPU</button>
                    <button data-metric="gpuHours" data-color="#ff7f0e" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">GPU</button>
                    <button data-metric="fpgaHours" data-color="#2ca02c" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">FPGA</button>
                    <button data-metric="memoryHours" data-color="#d62728" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">Memory</button>
                    <button data-metric="storageHours" data-color="#9467bd" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">Ephemeral Storage</button>
                </div>
            </div>

            <div class="mb-8">
                <div id="namespace-chart"></div>
            </div>

            <!-- Namespace Stats Table -->
            <div class="mb-8">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xl font-semibold">Namespace Resource Table</h3>
                    <button id="download-namespace-stats" class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-3 py-1.5 rounded border">Download CSV</button>
                </div>
                    <CheckboxTable
                      containerId="ns-stats-container"
                      title=""
                      tableKey="ns-stats"
                      selectAllId="ns-stats-select-all"
                      tbodyId="namespace-stats-table-body"
                      checkboxClass="no-checkbox"
                      showSelectAll={false}
                      defaultSortKey="namespace"
                      defaultSortDir="asc"
                      wrapperClass="overflow-x-auto bg-white border border-gray-200 rounded-lg max-h-[28rem] overflow-y-auto"
                  columns={[
                    { key: 'namespace', label: 'Namespace', type: 'string', filterId: 'ns-stats-namespace-filter' },
                    { key: 'cpuHours', label: 'CPU Hours', type: 'number', filterId: 'ns-stats-cpu-filter' },
                    { key: 'gpuHours', label: 'GPU Hours', type: 'number', filterId: 'ns-stats-gpu-filter' },
                    { key: 'memoryHours', label: 'Memory Hours', type: 'number', filterId: 'ns-stats-memory-filter' },
                    { key: 'storageHours', label: 'Ephemeral Storage Hours', type: 'number', filterId: 'ns-stats-storage-filter' },
                    { key: 'fpgaHours', label: 'FPGA Hours', type: 'number', filterId: 'ns-stats-fpga-filter' },
                    { key: 'PI', label: 'PI', type: 'string', filterId: 'ns-stats-pi-filter' },
                    { key: 'institution', label: 'Institution', type: 'string', filterId: 'ns-stats-institution-filter' },
                    { key: 'description', label: 'Description', type: 'string', filterId: 'ns-stats-description-filter' },
                  ]}
                />
            </div>
        </div>

        <!-- Node Charts -->
        <div id="node-stats">
            <h2 class="text-2xl font-bold mb-6">Usage by Node</h2>

            <div class="mb-4 border-b border-gray-200">
                <div id="node-chart-tabs" class="flex gap-2">
                    <button data-metric="cpuHours" data-color="#1f77b4" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">CPU</button>
                    <button data-metric="gpuHours" data-color="#ff7f0e" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">GPU</button>
                    <button data-metric="fpgaHours" data-color="#2ca02c" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">FPGA</button>
                    <button data-metric="memoryHours" data-color="#d62728" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">Memory</button>
                    <button data-metric="storageHours" data-color="#9467bd" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 border-b-2 border-transparent">Ephemeral Storage</button>
                </div>
            </div>

            <div class="mb-8">
                <div id="node-chart"></div>
            </div>

            <!-- Node Stats Table -->
            <div class="mb-8">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xl font-semibold">Node Resource Table</h3>
                    <button id="download-node-stats" class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-3 py-1.5 rounded border">Download CSV</button>
                </div>
                    <CheckboxTable
                      containerId="node-stats-container"
                      title=""
                      tableKey="node-stats"
                      selectAllId="node-stats-select-all"
                      tbodyId="node-stats-table-body"
                      checkboxClass="no-checkbox"
                      showSelectAll={false}
                      defaultSortKey="node"
                      defaultSortDir="asc"
                      wrapperClass="overflow-x-auto bg-white border border-gray-200 rounded-lg max-h-[28rem] overflow-y-auto"
                  columns={[
                    { key: 'node', label: 'Node', type: 'string', filterId: 'node-stats-node-filter' },
                    { key: 'gpuType', label: 'GPU Type', type: 'string', filterId: 'node-stats-gpuType-filter' },
                    { key: 'cpuHours', label: 'CPU Hours', type: 'number', filterId: 'node-stats-cpu-filter' },
                    { key: 'gpuHours', label: 'GPU Hours', type: 'number', filterId: 'node-stats-gpu-filter' },
                    { key: 'memoryHours', label: 'Memory Hours', type: 'number', filterId: 'node-stats-memory-filter' },
                    { key: 'storageHours', label: 'Ephemeral Storage Hours', type: 'number', filterId: 'node-stats-storage-filter' },
                    { key: 'fpgaHours', label: 'FPGA Hours', type: 'number', filterId: 'node-stats-fpga-filter' },
                  ]}
                />
            </div>
        </div>

        <!-- Usage by GPU -->
        <div id="gpu-stats">
            <h2 class="text-2xl font-bold mb-6">Usage by GPU</h2>
            <div id="gpu-pie-chart" class="mb-6"></div>
            <div class="mb-8">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xl font-semibold">GPU Type Table</h3>
                    <button id="download-gpu-stats" class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-3 py-1.5 rounded border">Download CSV</button>
                </div>
                <CheckboxTable
                  containerId="gpu-stats-container"
                  title=""
                  tableKey="gpu-stats"
                  selectAllId="gpu-stats-select-all"
                  tbodyId="gpu-stats-table-body"
                  checkboxClass="no-checkbox"
                  showSelectAll={false}
                  defaultSortKey="gpuType"
                  defaultSortDir="asc"
                  wrapperClass="overflow-x-auto bg-white border border-gray-200 rounded-lg max-h-[28rem] overflow-y-auto"
                  columns={[
                    { key: 'gpuType', label: 'GPU Type', type: 'string', filterId: 'gpu-stats-type-filter' },
                    { key: 'hours', label: 'Hours', type: 'number', filterId: 'gpu-stats-hours-filter' },
                  ]}
                />
            </div>
        </div>
    </div>
</section>

<script>
    import * as Plot from '@observablehq/plot';
    import * as d3 from 'd3';
    
    let allNamespaces = [];
    let allNodes = [];
    // Base rows for re-aggregation by (namespace, node, resource)
    let baseRows = [];
    // Metadata maps to enrich aggregates
    let namespaceMeta = new Map(); // ns -> { PI, institution, description }
    let nodeMeta = new Map(); // node -> { region, zone, gpuType, fpgaType, taints }
    let rawResourceData = [];
    let currentMode = 'allocated'; // 'allocated' | 'used'

    // Initialize dates with constraints
    const initializeDates = () => {
        const today = new Date();
        const minDate = new Date('2023-09-15'); // earliest aggregation date

        // Default range: last 7 days, clamped within [minDate, today]
        let defaultEnd = today;
        let defaultStart = new Date();
        defaultStart.setDate(defaultStart.getDate() - 7);
        if (defaultStart < minDate) defaultStart = new Date(minDate);

        const startEl = document.getElementById('start-date');
        const endEl = document.getElementById('end-date');
        const toYMD = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().split('T')[0];

        // Apply input constraints and defaults
        startEl.min = toYMD(minDate);
        startEl.max = toYMD(today);
        endEl.min = toYMD(minDate);
        endEl.max = toYMD(today);

        startEl.value = toYMD(defaultStart);
        endEl.value = toYMD(defaultEnd);
    };

    const parseUTCDateYMD = (inputEl) => {
        if (!inputEl) return null;
        const v = inputEl.value;
        if (!v) return null;
        const [y, m, d] = v.split('-').map(Number);
        const ms = Date.UTC(y, (m || 1) - 1, d || 1, 0, 0, 0, 0);
        return new Date(ms);
    };

    const getDateRange = () => {
        const startEl = document.getElementById('start-date');
        const endEl = document.getElementById('end-date');
        let startDate = parseUTCDateYMD(startEl);
        let endDate = parseUTCDateYMD(endEl);
        if (!startDate || !endDate) {
            const now = new Date();
            // Default to UTC midnight today and 7 days prior
            const endMs = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), 0, 0, 0, 0);
            endDate = new Date(endMs);
            startDate = new Date(endMs - 7 * 24 * 60 * 60 * 1000);
        }
        return { startDate, endDate };
    };

    const validateDateRange = () => {
        const startEl = document.getElementById('start-date');
        const endEl = document.getElementById('end-date');
        const { startDate, endDate } = getDateRange();
        const today = new Date();
        const maxDate = new Date('2023-09-15');

        if (!startEl.value || !endEl.value) {
            setStatus('Please select both start and end dates.', 'error', false);
            return { ok: false };
        }

        if (isNaN(startDate) || isNaN(endDate)) {
            setStatus('Invalid Date(s)', 'error', false);
            return { ok: false };
        }

        // Enforce: start <= today, end <= today, start < end, start >= maxDate
        if (startDate > today || endDate > today || startDate >= endDate || startDate < maxDate) {
            setStatus('Invalid Date(s)', 'error', false);
            return { ok: false };
        }

        return { ok: true };
    };

    // Fetch namespace info via RPC using @open-rpc/client-js
    const fetchNamespaceInfo = async () => {
        try {
            const { HTTPTransport, Client, RequestManager } = await import('@open-rpc/client-js');
            const baseUrl = import.meta.env.PUBLIC_SVC_URL || "https://portal.nrp.ai";
            const transport = new HTTPTransport(`${baseUrl}/rpc`);
            const client = new Client(new RequestManager([transport]));
            const result = await client.request({method: 'guest.ListNsInfo', params: {}});
            console.log('Namespace RPC result:', result);
            return result?.Namespaces || [];
        } catch (error) {
            console.error('Error fetching namespace info:', error);
            return [];
        }
    };

    // Fetch node info via RPC using @open-rpc/client-js
    const fetchNodeInfo = async () => {
        try {
            const { HTTPTransport, Client, RequestManager } = await import('@open-rpc/client-js');
            const baseUrl = import.meta.env.PUBLIC_SVC_URL || "https://portal.nrp.ai";
            const transport = new HTTPTransport(`${baseUrl}/rpc`);
            const client = new Client(new RequestManager([transport]));
            const result = await client.request({method: 'guest.ListNodeInfo', params: {}});
            console.log('Node RPC result:', result);
            return result?.Nodes || [];
        } catch (error) {
            console.error('Error fetching node info:', error);
            return [];
        }
    };

    const fetchResourceData = async () => {
        try {
            const { startDate, endDate } = getDateRange();
            const metric = currentMode === 'used' ? 'namespace_used_resources' : 'namespace_allocated_resources';

            // Build non-overlapping weekly chunks like the Observable notebook
            const msPerDay = 24 * 60 * 60 * 1000;
            // Compute whole-day difference based on local-midnight dates to avoid DST drift
            const totalDays = Math.floor((endDate.getTime() - startDate.getTime()) / msPerDay);
            const maxWeeks = Math.floor(totalDays / 7);
            // If exactly 7 days, start at 0; else start at floor(days/7)
            const startWeeks = totalDays === 7 ? 0 : maxWeeks;
            const dateRanges = [];
            for (let weeks = startWeeks; weeks >= 0; weeks--) {
                const spanDays = (totalDays - 7 * weeks >= 7 || totalDays - 7 * weeks === 0) ? 7 : (totalDays - 7 * weeks);
                let searchEndDate = new Date(endDate.getTime() - 7 * weeks * msPerDay);
                let searchEnd = Math.floor(searchEndDate.getTime() / 1000);
                // Add +1s to all but the earliest chunk to avoid overlapping timestamps.
                // For an exact 7-day window (weeks=0, maxWeeks=1), this adds +1s to the only chunk.
                if (weeks !== maxWeeks) {
                    searchEnd += 1;
                }
                dateRanges.push([spanDays, searchEnd]);
            }

            // Execute chunked queries in parallel
            const queries = dateRanges.map(([spanDays, searchEnd]) => {
                const q = `sum_over_time(${metric}[${spanDays}d:1h]@${searchEnd})`;
                // Prefer strict, deduplicated results to avoid partial data
                // without forcing raw resolution (keep downsampling allowed).
                const url = `https://thanos.nrp-nautilus.io/api/v1/query?query=${encodeURIComponent(q)}&dedup=true&partial_response=false`;
                console.log(`[${currentMode}] Prometheus query:`, q);
                return fetch(url).then(r => r.ok ? r.json() : Promise.reject(new Error(`${r.status} ${r.statusText}`)));
            });

            const [results, namespaceInfo, nodeInfo] = await Promise.all([
                Promise.allSettled(queries),
                fetchNamespaceInfo().catch(() => {
                    console.warn('Namespace info unavailable, continuing with empty data');
                    return [];
                }),
                fetchNodeInfo().catch(() => {
                    console.warn('Node info unavailable, continuing with empty data');  
                    return [];
                })
            ]);

            // Merge successful chunk results
            let merged = [];
            let hadFailure = false;
            for (const res of results) {
                if (res.status === 'fulfilled') {
                    const arr = res.value?.data?.result || [];
                    if (arr.length === 0) hadFailure = true; // parity with notebook's partial failure flag
                    merged = merged.concat(arr);
                } else {
                    console.warn('Chunk query failed:', res.reason);
                    hadFailure = true;
                }
            }
            rawResourceData = merged;
            console.log('Raw resource data count (merged):', rawResourceData.length, 'chunks:', results.length, 'partialFailure:', hadFailure);

            if (rawResourceData.length > 0) {
                console.log('Sample resource data:', rawResourceData[0]);
                const resourceTypes = [...new Set(rawResourceData.map(r => r.metric?.resource).filter(Boolean))];
                console.log('Available resource types:', resourceTypes);
            }

            return { rawResourceData, namespaceInfo, nodeInfo };
        } catch (error) {
            console.error('Error fetching resource data:', error);
            return { rawResourceData: [], namespaceInfo: [], nodeInfo: [] };
        }
    };

    // Resource conversion functions from Observable notebook
    const convertResource = (resource) => {
        if (resource?.includes("amd_com_xilinx")) return "fpga";
        if (resource == "cpu") return "cpu";
        if (resource?.includes("nvidia_com")) return "gpu";
        if (resource == "memory") return "memory";
        if (resource == "ephemeral_storage") return "storage";
        return "other";
    };

    const convertValue = (resource, value) => {
        if (resource == "memory" || resource == "ephemeral_storage") {
            return value / 1000000000; // Convert to GB
        }
        return value;
    };

    const aggregateData = ({ rawResourceData, namespaceInfo, nodeInfo }) => {
        // Build exact notebook-style rows merged by (namespace,node,converted resource)
        const rows = [];
        const getKey = (ns, node, r) => `${ns}||${node}||${r}`;
        const rowMap = new Map();
        rawResourceData.forEach(result => {
            const labels = result.metric || {};
            const namespace = labels.namespace;
            const node = labels.node;
            const rawRes = labels.resource;
            const v = parseFloat(result.value?.[1] ?? '0');
            if (!namespace || !node || !rawRes) return;
            const res = convertResource(rawRes);
            const inc = convertValue(rawRes, v);
            const k = getKey(namespace, node, res);
            if (rowMap.has(k)) {
                rowMap.get(k).value += inc;
            } else {
                const obj = { namespace, node, resource: res, value: inc };
                rowMap.set(k, obj);
                rows.push(obj);
            }
        });
        // Save base rows for selection-based re-aggregation
        baseRows = rows.slice();

        // Lookup info
        const nsInfoMap = new Map(namespaceInfo.map(ns => [ns.Name, ns]));
        const nodeInfoMap = new Map(nodeInfo.map(n => [n.Name, n]));

        // Aggregate to namespaces
        const namespaceMap = new Map();
        rows.forEach(r => {
            if (!namespaceMap.has(r.namespace)) {
                const nsInfo = nsInfoMap.get(r.namespace) || {};
                namespaceMap.set(r.namespace, {
                    namespace: r.namespace,
                    institution: nsInfo.Institution || 'unknown',
                    description: nsInfo.Description || 'unknown',
                    PI: nsInfo.PI || 'unknown',
                    cpuHours: 0,
                    memoryHours: 0,
                    gpuHours: 0,
                    fpgaHours: 0,
                    storageHours: 0
                });
            }
            const ns = namespaceMap.get(r.namespace);
            if (r.resource === 'cpu') ns.cpuHours += r.value;
            else if (r.resource === 'memory') ns.memoryHours += r.value;
            else if (r.resource === 'gpu') ns.gpuHours += r.value;
            else if (r.resource === 'fpga') ns.fpgaHours += r.value;
            else if (r.resource === 'storage') ns.storageHours += r.value;
        });

        // Aggregate to nodes
        const nodeMap = new Map();
        rows.forEach(r => {
            if (!nodeMap.has(r.node)) {
                const nInfo = nodeInfoMap.get(r.node) || {};
                nodeMap.set(r.node, {
                    node: r.node,
                    owner: nInfo.OwnerName || 'unknown',
                    region: nInfo.Region || 'unknown',
                    zone: nInfo.Zone || 'unknown',
                    gpuType: nInfo.GPUType || 'unknown',
                    fpgaType: nInfo.FPGAType || 'unknown',
                    taints: Array.isArray(nInfo.Taints)
                        ? nInfo.Taints.map(t => (t.key ?? t.Key) + (t.value ? '=' + t.value : '')).join(',')
                        : 'unknown',
                    cpuHours: 0,
                    memoryHours: 0,
                    gpuHours: 0,
                    fpgaHours: 0,
                    storageHours: 0
                });
            }
            const nd = nodeMap.get(r.node);
            if (r.resource === 'cpu') nd.cpuHours += r.value;
            else if (r.resource === 'memory') nd.memoryHours += r.value;
            else if (r.resource === 'gpu') nd.gpuHours += r.value;
            else if (r.resource === 'fpga') nd.fpgaHours += r.value;
            else if (r.resource === 'storage') nd.storageHours += r.value;
        });

        allNamespaces = Array.from(namespaceMap.values());
        allNodes = Array.from(nodeMap.values());
        // Build metadata maps from aggregated lists
        namespaceMeta = new Map();
        allNamespaces.forEach(ns => {
            namespaceMeta.set(ns.namespace, {
                PI: ns.PI || 'unknown',
                institution: ns.institution || 'unknown',
                description: ns.description || ''
            });
        });
        nodeMeta = new Map();
        allNodes.forEach(n => {
            nodeMeta.set(n.node, {
                region: n.region || 'unknown',
                zone: n.zone || 'unknown',
                gpuType: n.gpuType || 'unknown',
                fpgaType: n.fpgaType || 'unknown',
                taints: n.taints || ''
            });
        });
    };

    const applyRegexFilters = () => {
        try {
            const namespaceNameRegex = new RegExp(document.getElementById('namespace-name-filter').value || '.*', 'i');
            const namespaceInstitutionRegex = new RegExp(document.getElementById('namespace-institution-filter').value || '.*', 'i');
            const namespacePiRegex = new RegExp(document.getElementById('namespace-pi-filter').value || '.*', 'i');
            const namespaceDescriptionRegex = new RegExp(document.getElementById('namespace-description-filter')?.value || '.*', 'i');
            const nodeNameRegex = new RegExp(document.getElementById('node-name-filter').value || '.*', 'i');
            const nodeOwnerRegex = new RegExp(document.getElementById('node-owner-filter').value || '.*', 'i');
            const nodeRegionRegex = new RegExp(document.getElementById('node-region-filter').value || '.*', 'i');
            const nodeZoneRegex = new RegExp(document.getElementById('node-zone-filter').value || '.*', 'i');
            const nodeGpuRegex = new RegExp(document.getElementById('node-gpu-filter').value || '.*', 'i');
            const nodeFpgaRegex = new RegExp(document.getElementById('node-fpga-filter').value || '.*', 'i');
            const nodeTaintsRegex = new RegExp(document.getElementById('node-taints-filter').value || '.*', 'i');

            const filteredNamespaces = allNamespaces.filter(ns => 
                namespaceNameRegex.test(ns.namespace || '') && 
                namespacePiRegex.test(ns.PI || '') &&
                namespaceInstitutionRegex.test(ns.institution || '') &&
                namespaceDescriptionRegex.test(ns.description || '')
            );

            const filteredNodes = allNodes.filter(node => 
                nodeNameRegex.test(node.node) &&
                nodeOwnerRegex.test(node.owner || '') &&
                nodeRegionRegex.test(node.region) &&
                nodeZoneRegex.test(node.zone) &&
                nodeGpuRegex.test(node.gpuType) &&
                nodeFpgaRegex.test(node.fpgaType) &&
                nodeTaintsRegex.test(node.taints)
            );

            // Regex filters control what appears in the checkbox tables for their respective domains
            updateNamespaceTable(filteredNamespaces);
            updateNodeTable(filteredNodes);
            // After rebuilding checkbox tables, refresh charts/tables from checked rows.
            updateCharts();
        } catch (error) {
            console.error('Invalid regex:', error);
        }
    };

    const updateNamespaceTable = (namespaces) => {
        const tbody = document.getElementById('namespaces-table-body');
        tbody.innerHTML = '';

        // Apply sorting for Selected Namespaces
        let nsRows = Array.isArray(namespaces) ? namespaces.slice() : [];
        const nsSelState = sortStates['ns-selected'];
        if (nsSelState && nsSelState.key) {
            const dir = nsSelState.dir === 'asc' ? 1 : -1;
            const acc = nsSelectedAccessors[nsSelState.key] || ((r) => r[nsSelState.key]);
            nsRows.sort((a,b) => compareValues(acc(a), acc(b)) * dir);
        } else {
            nsRows.sort((a, b) => (b.cpuHours + b.gpuHours + b.memoryHours) - (a.cpuHours + a.gpuHours + a.memoryHours));
        }
        currentSelectedNamespaces = nsRows.slice();
        nsRows.forEach(ns => {
            const row = document.createElement('tr');
            row.innerHTML = `
                <td class="px-6 py-4 whitespace-nowrap">
                    <input type="checkbox" class="namespace-checkbox" value="${ns.namespace}" checked>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${ns.namespace}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${ns.PI || ''}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${ns.institution}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${ns.description || ''}</td>
            `;
            tbody.appendChild(row);
        });

        // Update header indicators
        updateSortIndicators('ns-selected');

        // Add event listeners for checkboxes
        document.querySelectorAll('.namespace-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', () => {
                syncNamespaceHeaderCheckbox();
                updateCharts();
            });
        });

        // Sync header checkbox state
        syncNamespaceHeaderCheckbox();
    };

    let currentFilteredNamespaces = [];
    let currentFilteredNodes = [];
    // Keep current lists for sortable selected tables
    let currentSelectedNamespaces = [];
    let currentSelectedNodes = [];

    // Sorting state and helpers
    const sortStates = {
        'ns-selected': { key: null, dir: 'asc' },
        'nodes-selected': { key: null, dir: 'asc' },
        'ns-stats': { key: 'namespace', dir: 'asc' },
        'node-stats': { key: 'node', dir: 'asc' },
        'gpu-stats': { key: 'gpuType', dir: 'asc' },
    };

    const compareValues = (a, b) => {
        const an = typeof a === 'number' && !isNaN(a);
        const bn = typeof b === 'number' && !isNaN(b);
        let va = a, vb = b;
        if (!(an && bn)) {
            va = (va ?? '').toString().toLowerCase();
            vb = (vb ?? '').toString().toLowerCase();
        }
        if (va < vb) return -1;
        if (va > vb) return 1;
        return 0;
    };

    // Accessors per table
    const nsStatsAccessors = {
        namespace: r => r.namespace || '',
        cpuHours: r => r.cpuHours || 0,
        gpuHours: r => r.gpuHours || 0,
        memoryHours: r => r.memoryHours || 0,
        storageHours: r => r.storageHours || 0,
        fpgaHours: r => r.fpgaHours || 0,
        PI: r => r.PI || '',
        institution: r => r.institution || '',
        description: r => r.description || ''
    };
    const nodeStatsAccessors = {
        node: r => r.node || '',
        gpuType: r => r.gpuType || '',
        cpuHours: r => r.cpuHours || 0,
        gpuHours: r => r.gpuHours || 0,
        memoryHours: r => r.memoryHours || 0,
        storageHours: r => r.storageHours || 0,
        fpgaHours: r => r.fpgaHours || 0
    };
    const gpuAccessors = {
        gpuType: r => r.gpuType || '',
        hours: r => r.hours || 0
    };
    const nsSelectedAccessors = {
        namespace: r => r.namespace || '',
        PI: r => r.PI || '',
        institution: r => r.institution || '',
        description: r => r.description || ''
    };
    const nodeSelectedAccessors = {
        node: r => r.node || '',
        owner: r => r.owner || '',
        region: r => r.region || '',
        zone: r => r.zone || '',
        gpuType: r => r.gpuType || '',
        fpgaType: r => r.fpgaType || '',
        taints: r => r.taints || ''
    };

    const updateNamespaceStatsTable = (namespaces) => {
        currentFilteredNamespaces = Array.isArray(namespaces) ? namespaces.slice() : [];
        const tbody = document.getElementById('namespace-stats-table-body');
        if (!tbody) return;
        tbody.innerHTML = '';
        // Apply in-table filters (regex, case-insensitive)
        const nameR = new RegExp((document.getElementById('ns-stats-namespace-filter')?.value || '.*'), 'i');
        const cpuR = new RegExp((document.getElementById('ns-stats-cpu-filter')?.value || '.*'), 'i');
        const gpuR = new RegExp((document.getElementById('ns-stats-gpu-filter')?.value || '.*'), 'i');
        const memR = new RegExp((document.getElementById('ns-stats-memory-filter')?.value || '.*'), 'i');
        const storR = new RegExp((document.getElementById('ns-stats-storage-filter')?.value || '.*'), 'i');
        const fpgaR = new RegExp((document.getElementById('ns-stats-fpga-filter')?.value || '.*'), 'i');
        const piR = new RegExp((document.getElementById('ns-stats-pi-filter')?.value || '.*'), 'i');
        const instR = new RegExp((document.getElementById('ns-stats-institution-filter')?.value || '.*'), 'i');
        const descR = new RegExp((document.getElementById('ns-stats-description-filter')?.value || '.*'), 'i');

        let rows = currentFilteredNamespaces.slice().filter(ns =>
            nameR.test(ns.namespace || '') &&
            cpuR.test(((ns.cpuHours || 0).toFixed ? ns.cpuHours.toFixed(2) : ns.cpuHours).toString()) &&
            gpuR.test(((ns.gpuHours || 0).toFixed ? ns.gpuHours.toFixed(2) : ns.gpuHours).toString()) &&
            memR.test(((ns.memoryHours || 0).toFixed ? ns.memoryHours.toFixed(2) : ns.memoryHours).toString()) &&
            storR.test(((ns.storageHours || 0).toFixed ? ns.storageHours.toFixed(2) : ns.storageHours).toString()) &&
            fpgaR.test(((ns.fpgaHours || 0).toFixed ? ns.fpgaHours.toFixed(2) : ns.fpgaHours).toString()) &&
            piR.test(ns.PI || '') &&
            instR.test(ns.institution || '') &&
            descR.test(ns.description || '')
        );
        // Persist filtered rows for CSV/export
        currentFilteredNamespaces = rows.slice();
        const nsStatsState = sortStates['ns-stats'];
        if (nsStatsState && nsStatsState.key) {
            const dir = nsStatsState.dir === 'asc' ? 1 : -1;
            const acc = nsStatsAccessors[nsStatsState.key] || ((r) => r[nsStatsState.key]);
            rows.sort((a,b) => compareValues(acc(a), acc(b)) * dir);
        } else {
            rows.sort((a, b) => (b.cpuHours + b.gpuHours + b.memoryHours + b.storageHours + b.fpgaHours) - (a.cpuHours + a.gpuHours + a.memoryHours + a.storageHours + a.fpgaHours));
        }

        rows.forEach(ns => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${ns.namespace}</td>
